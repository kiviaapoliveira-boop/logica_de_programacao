programa {
  funcao inicio() {
      inteiro mes

      escreva("Digite o número do mês (1 a 12) ")
      leia(mes)

      se (mes >= 12){

        escreva("Janeiro")

        escreva("Fevereiro")

        escreva("Março")

        escreva("Abril")

        escreva("Maio")
        
        escreva("Junho") 
        
        escreva("Julho")
        
        escreva("Agosto")
        
        escreva("Setembro")
        
        escreva("Outubro")
        
        escreva("Novembro")
        
        escreva("Dezembro")
      }
      senao{
        escreva("Mês inválido!")
      }
      }
  }
}
