programa {
  funcao inicio() {
   inteiro i, n
   real numero

    escreva("Digite o número: ")
    leia(n)

    para( i = 1; i <= n; i++){
    

    se(numero > 0){
      escreva("O número é positivo ")
      leia(numero)
    }
    senao {
      se(numero < 0)
      escreva("O número é negativo ")
      leia(numero)

      se(numero <= 0){
        escreva("O número é zero ")
        leia(numero)
      }
      }
    }
    }
    }
  }
}
